{
  "name": "notedeck",
  "author": {
    "name": "Codvanta365",
    "email": "your-email@example.com"
  },
  "version": "1.0.0",
  "productVersion": "0001",
  "description": "Offline-first desktop notes app built with Electron",
  "homepage": "https://github.com/yourusername/notedeck",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac zip",
    "build:mac:arm64": "electron-builder --mac zip --arm64",
    "build:mac:dmg": "electron-builder --mac dmg"
  },
  "dependencies": {
    "html-to-docx": "^1.8.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.notedeck.app",
    "productName": "NoteDeck",
    "linux": {
      "maintainer": "rabbyhasansaref83@gmail.com",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
